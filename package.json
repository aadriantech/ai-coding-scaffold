{
	"name": "ai-coding-scaffold",
	"version": "1.3.4",
	"private": true,
	"type": "module",
	"description": "Portable plan-before-code agent infrastructure with Vitest + Playwright",
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
