		"validate": "bash scripts/check_coverage.sh && npm run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@vitest/coverage-v8": "^3.2.6",
		"serve": "^14.2.4",
		"typescript": "^6.0.3",
		"vitest": "^3.2.4"
	}
}